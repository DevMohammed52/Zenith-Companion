name = "zenith-profile-import"
main = "src/index.mjs"
compatibility_date = "2026-05-15"
workers_dev = true
preview_urls = false

[triggers]
crons = ["* * * * *"]

[vars]
ALLOWED_ORIGINS = "https://your-vercel-domain.vercel.app,https://www.your-custom-domain.com,http://localhost:3000"
IMPORT_MAX_PENDING = "25"
IMPORT_MAX_CONCURRENT = "1"
IMPORT_BASELINE_REQUEST_CAP = "45"
IMPORT_MUSEUM_MAX_PAGES_PER_CHARACTER = "8"
USAGE_PING_MAX_PER_MINUTE = "120"
USAGE_VITALS_MAX_PER_MINUTE = "80"
ERROR_REPORT_MAX_PER_MINUTE = "30"
IDLEMMO_IMPORT_DELAY_MS = "1800"
IMPORT_COORDINATOR_SOURCES = "github-actions:update_data,github-actions:update_guild_data"

[[d1_databases]]
binding = "DB"
database_name = "zenith_profile_import"
database_id = "replace-with-cloudflare-d1-database-id"

[[kv_namespaces]]
binding = "ZENITH_COORDINATOR"
id = "replace-with-cloudflare-kv-namespace-id"

# Secrets to set with Wrangler or the Cloudflare dashboard:
# - IDLEMMO_API_KEY
# - SCRAPER_COORDINATOR_SECRET
# - ADMIN_DASHBOARD_SECRET
# - USAGE_PING_SECRET
# - ERROR_REPORT_SECRET (optional; falls back to USAGE_PING_SECRET)
# - IMPORT_SIGNING_SECRET
# - IMPORT_ENCRYPTION_SECRET
# - TURNSTILE_SECRET_KEY
