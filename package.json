{
  "name": "zenith-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently \"node --env-file=.env scraper.mjs\" \"next dev\"",
    "build": "node scripts/build-item-lore-signals.mjs && node scripts/build-enemy-weather-preferences.mjs && node scripts/rebuild-usage-map.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:a11y": "playwright test tests/a11y",
    "audit:deadcode": "knip --exclude exports,types",
    "audit:lighthouse": "node scripts/run-lighthouse-audit.mjs",
    "rebuild": "node scripts/build-item-lore-signals.mjs && node scripts/build-enemy-weather-preferences.mjs && node scripts/rebuild-usage-map.mjs",
    "scrape": "node --env-file=.env scraper.mjs --once",
    "scrape:priority": "node --env-file=.env scraper.mjs --priority --once",
    "scrape:pets": "node --env-file=.env scraper.mjs --pets-only --once",
    "scrape:locations": "node --env-file=.env scraper.mjs --world-locations-only",
    "idlemmo:cache": "node --env-file=.env scripts/fetch-idlemmo-cache.mjs",
    "idlemmo:guild": "node --env-file=.env scripts/fetch-idlemmo-guild.mjs",
    "idlemmo:guild-intel": "node --env-file=.env scripts/fetch-idlemmo-guild-intelligence.mjs",
    "idlemmo:guild-full": "node --env-file=.env scripts/fetch-idlemmo-guild-intelligence.mjs --all-guilds --source range --out local_data/guild_intelligence_all --rate-profile isolated",
    "idlemmo:guild-public": "node scripts/build-guild-public-data.mjs",
    "idlemmo:guild-public:merge": "node scripts/build-guild-public-data.mjs --merge-existing",
    "idlemmo:guild-refresh": "node --env-file=.env scripts/refresh-idlemmo-guild-public-data.mjs --tier hot --discover-new --rate-profile shared",
    "idlemmo:conquest": "node --env-file=.env scraper.mjs --conquest-only",
    "idlemmo:persona": "node --env-file=.env scripts/fetch-idlemmo-persona.mjs",
    "idlemmo:persona-summary": "node scripts/build-idlemmo-persona-summary.mjs",
    "idlemmo:derive": "node scripts/build-idlemmo-derived-cache.mjs",
    "idlemmo:pets": "node scripts/build-pet-database.mjs",
    "verify:profile-import": "node scripts/verify-profile-import-normalizer.mjs",
    "verify:guild-conquest": "node scripts/verify-guild-conquest-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "knip": "^6.14.1",
    "lighthouse": "^13.3.0",
    "playwright": "^1.60.0",
    "postcss": "8.5.13",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
